{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @playbit/api build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @playbit/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
