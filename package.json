{
  "name": "playbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @playbit/api --filter @playbit/player dev",
    "dev:api": "pnpm --filter @playbit/api dev",
    "dev:player": "pnpm --filter @playbit/player dev",
    "build:player": "pnpm --filter @playbit/player build",
    "verify:player": "pnpm --filter @playbit/player test:browser",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm --filter @playbit/game-core test && pnpm --filter @playbit/api test && pnpm --filter @playbit/player test",
    "verify:browser": "pnpm --filter @playbit/player test:browser",
    "db:generate": "pnpm --filter @playbit/api db:generate",
    "db:migrate": "pnpm --filter @playbit/api db:migrate"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
